#!/usr/bin/env bash
# Keep the Hermes desktop app's connection files in step with the container's
# dashboard session token.
#
# TWO files hold it, and the app reads the second one:
#   ~/.config/Hermes/connection.json    older single-connection file
#   ~/.config/Hermes/connections.json   the v2 store the app actually boots from
#                                       (connections[] entry id 127-0-0-1-<port>)
# Updating only connection.json left the app on a stale token ("session
# expired") while this script and the healthcheck both reported success.
#
# Why this exists: the token is minted in-memory at
# /opt/hermes/hermes_cli/web_server.py:281 as
#   os.environ.get("HERMES_DASHBOARD_SESSION_TOKEN") or secrets.token_urlsafe(32)
# so it ROTATES on every dashboard restart, and the desktop app then shows
# "your remote gateway session has expired". Nothing is actually wrong; the
# app is just holding a stale token.
#
# Run at boot (see hermes-desktop-token-sync.service) or by hand any time the
# app complains.
set -euo pipefail

# host/ scripts are installed to ~/.local/bin and run detached from this repo,
# so they cannot source a repo-relative path. Try both locations; fall back to
# self-contained definitions if neither is present, because these scripts must
# keep working even if the repo is deleted after installation.
_hermes_common_loaded=0
for _c in "$(dirname "$(readlink -f "$0")")/../scripts/lib/common.sh" \
          "$HOME/.local/lib/hermes-quickstart/common.sh"; do
  if [ -r "$_c" ]; then . "$_c"; _hermes_common_loaded=1; break; fi
done
if [ "$_hermes_common_loaded" = 0 ]; then
  hermes_dashboard_token() {
    curl -s --max-time "${2:-8}" -H 'Host: localhost' "${1:?}/" 2>/dev/null \
      | grep -oP '__HERMES_SESSION_TOKEN__\s*=\s*"\K[^"]+' | head -1
  }
  hermes_dashboard_ok() { [ -n "$(hermes_dashboard_token "${1:?}" "${2:-6}")" ]; }
  hermes_forward_restart() {
    timeout 60 openshell forward stop "${1:?}" "${2:?}" >/dev/null 2>&1 || true
    timeout 120 openshell forward start --background "${1:?}" "${2:?}" >/dev/null 2>&1 || true
  }
fi

CONN_DIR="${HERMES_DESKTOP_CONFIG_DIR:-$HOME/.config/Hermes}"
CONN="${HERMES_DESKTOP_CONN:-$CONN_DIR/connection.json}"
CONNS="${HERMES_DESKTOP_CONNS:-$CONN_DIR/connections.json}"
URL="${HERMES_CONTROL_UI_URL:-http://127.0.0.1:18795}"
TRIES="${HERMES_TOKEN_SYNC_TRIES:-60}"

[[ -f "$CONN" || -f "$CONNS" ]] \
  || { echo "no desktop config in $CONN_DIR -- nothing to sync" >&2; exit 0; }

# Wait for the dashboard to actually answer. Poll the real endpoint, not a
# container status: "Up" and "serving" are different things.
token=""
for _ in $(seq 1 "$TRIES"); do
  token="$(curl -s --max-time 5 -H 'Host: localhost' "$URL/" \
    | grep -oP '__HERMES_SESSION_TOKEN__\s*=\s*"\K[^"]+' | head -1 || true)"
  [[ -n "$token" ]] && break
  sleep 5
done
[[ -n "$token" ]] || { echo "dashboard did not serve a token at $URL" >&2; exit 1; }

# Only rewrite a file when its token actually changed -- keeps mtimes
# meaningful and makes a second run a no-op. Only the entry for OUR url is
# touched; every other connection in connections.json is preserved as it was.
python3 - "$token" "$URL" "$CONN" "$CONNS" <<'PY'
import json, os, sys, tempfile
token, url = sys.argv[1], sys.argv[2].rstrip("/")
for path in sys.argv[3:]:
    if not os.path.exists(path):
        continue
    with open(path) as fh:
        cfg = json.load(fh)
    changed = []
    def visit(o):
        if isinstance(o, dict):
            if str(o.get("url", "")).rstrip("/") == url and isinstance(o.get("token"), dict):
                t = o["token"]
                if t.get("value") != token:
                    changed.append((t.get("value") or "none")[:12])
                    t["value"] = token
                    t.setdefault("encoding", "plain")
            for v in list(o.values()):
                visit(v)
        elif isinstance(o, list):
            for v in o:
                visit(v)
    visit(cfg)
    name = os.path.basename(path)
    if not changed:
        print(f"{name}: token unchanged -- no rewrite")
        continue
    mode = os.stat(path).st_mode & 0o777
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as fh:
        json.dump(cfg, fh, indent=2)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    print(f"{name}: token updated: {changed[0]}... -> {token[:12]}...")
PY

# Prove it, rather than assuming: the token must actually authenticate.
code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $token" "$URL/api/sessions")"
[[ "$code" == 200 ]] || { echo "token written but /api/sessions returned $code" >&2; exit 1; }
echo "verified: /api/sessions -> 200"
